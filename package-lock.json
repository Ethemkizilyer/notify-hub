{
  "name": "notify-hub",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "notify-hub",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "apps/api": {
      "name": "@notifyhub/api",
      "version": "0.0.0"
    },
    "apps/web": {
      "name": "@notifyhub/web",
      "version": "0.0.0"
    },
    "node_modules/@notifyhub/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@notifyhub/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "node_modules/@notifyhub/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/shared": {
      "name": "@notifyhub/shared",
      "version": "0.0.0"
    }
  }
}
